---
layout: null
sitemap: false
---
{%- assign docs = site.pages | where_exp: "p", "p.name contains '.md'" -%}
[
{%- for p in docs -%}
  {
    "title": {{ p.title | default: p.name | jsonify }},
    "url": {{ p.url | prepend: site.baseurl | jsonify }},
    "path": {{ p.path | jsonify }},
    "content": {{ p.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
